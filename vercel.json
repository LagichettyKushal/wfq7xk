{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/data/**",
      "excludeFiles": "{backend/tests/**,backend/scripts/**,**/__pycache__/**,**/*.pyc,frontend/node_modules/**,Dockerfile,docker-compose.yml}"
    }
  }
}
